{
  "name": "precrime-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "generate-api": "openapi-generator-cli generate -i ../openapi.yaml -g typescript-angular -o src/app/api --additional-properties=stringEnums=true",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "basic-ftp": "^6.2.3"
  }
}
